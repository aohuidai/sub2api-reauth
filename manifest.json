{
  "manifest_version": 3,
  "name": "sub2api reoauth",
  "version": "0.3.0",
  "description": "查询待重授权账号并学习 OpenAI OAuth 登录流程",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "打开 sub2api reoauth"
  }
}
